          "request": {
            "name": "Token Approvals",
            "description": {
              "content": "Retrieve ERC-20 token approval (allowance) records for a wallet on a given chain.\n\n**Cost:** 1 credit per call\n\n**Get your API key:** [Dev Portal](https://data.octav.fi)",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "approvals",
                ":chain"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "addresses",
                  "value": "<string>",
                  "description": "(Required) Wallet address to fetch approvals for"
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "25",
                  "description": "Results per page (1-100, default 25)"
                },
                {
                  "disabled": false,
                  "key": "cursor",
                  "value": "<string>",
                  "description": "Cursor string from a previous response to fetch the next page"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "chain",
                  "description": "(Required) Chain identifier"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
