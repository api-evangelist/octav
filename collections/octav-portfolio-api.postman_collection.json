        {
          "id": "cdb46d20-0a32-434f-aa9f-9bf54f0c9dc9",
          "name": "Portfolio",
          "request": {
            "name": "Portfolio",
            "description": {
              "content": "Retrieve portfolio holdings across wallets and DeFi protocols.\n\n**Cost:** 1 credit per call\n\n**Get your API key:** [Dev Portal](https://data.octav.fi)",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "portfolio"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "addresses",
                  "value": "<string>",
                  "description": "(Required) EVM or SOL wallet address to retrieve portfolio data for"
                },
                {
                  "disabled": false,
                  "key": "includeImages",
                  "value": "false",
                  "description": "Include image URLs for chains, assets, and protocols"
                },
                {
                  "disabled": false,
                  "key": "includeExplorerUrls",
                  "value": "false",
                  "description": "Include blockchain explorer URLs for assets and transactions"
                },
                {
                  "disabled": false,
                  "key": "waitForSync",
                  "value": "false",
                  "description": "Wait for fresh data if cache is stale"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            }
          },
          "response": [
