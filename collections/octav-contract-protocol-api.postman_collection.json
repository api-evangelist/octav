  "item": [
    {
      "id": "a90267cf-a419-4166-aa6e-89df59654f09",
      "name": "Contract Protocol",
      "description": {
        "content": "Resolve a contract address to its DeFi protocol",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "a6fd21c9-3ad1-44c7-9cbe-35445b17cc9a",
          "name": "Contract Protocol",
          "request": {
            "name": "Contract Protocol",
            "description": {
              "content": "Look up which DeFi protocol a contract address belongs to. Provide a `chain` to resolve a single protocol on that chain, or omit it to search by address across all chains.\n\n**Cost:** 5 credits per lookup. The credits are refunded if no protocol is found (404).\n\n**Get your API key:** [Dev Portal](https://data.octav.fi)",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "contract-protocol"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "contract",
                  "value": "<string>",
                  "description": "(Required) The contract address to look up (EVM `0x…` or Solana base58)."
                },
                {
                  "disabled": false,
                  "key": "chain",
                  "value": "<string>",
                  "description": "Chain key (e.g. `ethereum`, `arbitrum`, `base`, `polygon`, `solana`). If omitted, the endpoint returns every chain the address is known on."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            }
          },
          "response": [
            {
              "id": "c8a55444-a20f-498f-944d-d9979308dedd",
              "name": "Protocol match. Returns a single `{ protocol }` object when `chain` is provided, or a `{ protocols }` array (each entry tagged with its `chainKey`) when `chain` is omitted. The array is unordered.",
              "originalRequest": {
                "url": {
                  "path": [
                    "contract-protocol"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [
                    {
                      "key": "contract",
                      "value": "0x1f98431c8ad98523631ae4a59f267346ea31f984"
                    },
                    {
                      "key": "chain",
                      "value": "ethereum"
                    }
                  ],
                  "variable": []
                },
                "header": [
                  {
                    "description": {
                      "content": "Added as a part of security scheme: bearer",
                      "type": "text/plain"
                    },
                    "key": "Authorization",
                    "value": "Bearer <token>"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "GET",
                "body": {}
