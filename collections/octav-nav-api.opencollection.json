{
  "opencollection": "1.0.0",
  "info": {
    "name": "Octav Airdrops Nav API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Nav",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Nav",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.octav.fi/v1/nav",
            "params": [
              {
                "name": "addresses",
                "value": "0x6426af179aabebe47666f345d69fd9079673f6cd",
                "type": "query",
                "description": "EVM or SOL wallet address to retrieve Net Asset Value for"
              },
              {
                "name": "waitForSync",
                "value": "",
                "type": "query",
                "description": "Wait for fresh data if cache is stale"
              },
              {
                "name": "currency",
                "value": "",
                "type": "query",
                "description": "Currency in which to return the Net Asset Value. Supports fiat and crypto conversion rates."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Retrieve Net Asset Value of an address.\n\n**Cost:** 1 credit per call\n\n**Get your API key:** [Dev Portal](https://data.octav.fi)"
        }
      ]
    }
  ],
  "bundled": true
}